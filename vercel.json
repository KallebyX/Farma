{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run vercel-build",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/expire-invitations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/dispatch-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/check-returns",
      "schedule": "0 9,15,21 * * *"
    },
    {
      "path": "/api/cron/deliver-webhooks",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-wearables",
      "schedule": "0 */2 * * *"
    }
  ]
}
