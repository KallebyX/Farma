# Supabase Postgres — pooler via PgBouncer (usado em runtime pelo Prisma Client)
# Vercel → Settings → Environment Variables → DATABASE_URL
# Formato: porta 6543 com ?pgbouncer=true
# Projeto Supabase: farma (ref: klsuismzlbdsswyfkssw, região: sa-east-1)
DATABASE_URL="postgresql://postgres.klsuismzlbdsswyfkssw:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta ao Supabase (usada pelo prisma migrate deploy no build)
# Vercel → Settings → Environment Variables → DIRECT_URL
# Formato: porta 5432 SEM ?pgbouncer
DIRECT_URL="postgresql://postgres.klsuismzlbdsswyfkssw:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Pool por instância (serverless). Default 5; lib/db.ts reescreve connection_limit=1→5. Evita P2024.
# PRISMA_CONNECTION_LIMIT="5"

# ── Supabase Storage (upload de exames) ───────────────────────────────────────
# Bucket privado "exams". A service-role key é secreta — só no servidor (Vercel).
# SUPABASE_URL="https://[ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_EXAMS_BUCKET="exams"

# Optional: least-privilege role (farma_app, NOBYPASSRLS) used by the app at
# runtime to ENFORCE row-level security per tenant. When set, tenant-scoped
# queries run as this role with the app.pharmacy_id GUC. Leave empty to keep
# using the privileged DATABASE_URL (RLS bypassed; app-layer scoping only).
# See docs/DEPLOY.md → "Ativando RLS por tenant".
DATABASE_URL_APP=""

# Auth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public app URL (used in invitation links)
APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Farma <no-reply@farma.app>"

# WhatsApp. WHATSAPP_PROVIDER = "zapi" (padrão) | "meta" | "twilio" | "mock".
# Sem credenciais → modo mock (loga no servidor) e fallback wa.me.
# WHATSAPP_PROVIDER="zapi"
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE_ID=""
WHATSAPP_API_BASE_URL="https://api.z-api.io"
# Twilio (WhatsApp) — defina WHATSAPP_PROVIDER="twilio" + estes:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Rate limit (Upstash Redis). Optional — falls back to in-memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Invitation expiry in days
INVITE_TTL_DAYS="7"

# Cron secret for /api/cron/expire-invitations
CRON_SECRET=""

# Override the CMED CSV download URL when Anvisa rolls the monthly slug.
# Defaults to the dados.anvisa.gov.br canonical CSV; only set this if the
# default 404s.
CMED_URL=""
