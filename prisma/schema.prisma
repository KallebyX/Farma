generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PHARMACIST
  ATTENDANT
  READONLY
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InvitationChannel {
  EMAIL
  WHATSAPP
  LINK
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model Pharmacy {
  id          String   @id @default(uuid())
  cnpj        String   @unique
  razaoSocial String
  fantasia    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Membership[]
  invitations Invitation[]
  patients    Patient[]
  apiKeys     ApiKey[]
  webhooks    WebhookEndpoint[]
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String?
  emailVerified  DateTime?
  consentVersion String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships  Membership[]
  invitedBy    Invitation[] @relation("InvitedBy")
  acceptedBy   Invitation[] @relation("AcceptedBy")
  sessions     Session[]
  patientsCreated      Patient[]      @relation("PatientCreatedBy")
  prescriptionsCreated Prescription[] @relation("PrescriptionCreatedBy")
  ramReviewed          RAMReport[]    @relation("RAMReviewedBy")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id          String       @id @default(uuid())
  userId      String
  pharmacyId  String
  role        Role
  crf         String?
  status      MemberStatus @default(ACTIVE)
  invitedById String?
  joinedAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@index([pharmacyId, status])
}

model Invitation {
  id           String              @id @default(uuid())
  pharmacyId   String
  email        String
  phone        String?
  role         Role
  crf          String?
  tokenHash    String              @unique
  status       InvitationStatus    @default(PENDING)
  channels     InvitationChannel[]
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime            @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?

  pharmacy   Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invitedBy  User                 @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?                @relation("AcceptedBy", fields: [acceptedById], references: [id])
  deliveries InvitationDelivery[]

  @@index([pharmacyId, status])
  @@index([email])
}

model InvitationDelivery {
  id           String            @id @default(uuid())
  invitationId String
  channel      InvitationChannel
  status       DeliveryStatus
  providerId   String?
  error        String?
  attemptedAt  DateTime          @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Medication catalog (shared across all tenants)
// ─────────────────────────────────────────────────────────────────────────────

enum DosageForm {
  TABLET
  CAPSULE
  LIQUID
  DROPS
  INJECTION
  CREAM
  OINTMENT
  INHALER
  PATCH
  OTHER
}

model MedicationCatalog {
  id                 String     @id @default(uuid())
  cmedGgrem          String?    @unique  // CMED código GGREM (Anvisa regulatory ID, also row key for sync)
  activeIngredient   String
  brandName          String
  dosage             String     // e.g. "50mg", "10mg/ml"
  form               DosageForm
  manufacturerName   String?
  manufacturerCnpj   String?    // detentor do registro (key for lab analytics)
  anvisaCode         String?
  ean                String?
  therapeuticClass   String?
  productType        String?    // CMED tipo: NEUTRO | GENÉRICO | SIMILAR | NOVO | ESPECÍFICO | BIOLÓGICO
  pmcMax             Decimal?   @db.Decimal(12, 4) // PMC máximo (preço máximo ao consumidor, alíquota mais alta)
  createdAt          DateTime   @default(now())

  prescriptions Prescription[]

  @@index([activeIngredient])
  @@index([brandName])
  @@index([pmcMax])
  @@unique([brandName, dosage, form, manufacturerCnpj])
}

// ─────────────────────────────────────────────────────────────────────────────
// Patient (identity + clinical, separated to support k-anonymized lab exports)
// ─────────────────────────────────────────────────────────────────────────────

enum PatientStatus {
  ACTIVE
  PAUSED
  WITHDRAWN
}

model Patient {
  id          String        @id @default(uuid())
  pharmacyId  String
  // identity (RESTRICTED — separates from clinical data for anonymization)
  name        String
  cpf         String?       // optional; some patients won't share
  phone       String        // E.164, used for WhatsApp
  birthDate   DateTime?
  age         Int?
  // clinical (less sensitive in isolation; useful for cohort queries)
  sex         String?       // M | F | O | null
  comorbidities String[]    @default([])
  allergies   String[]      @default([])
  customMedications String[] @default([])
  notes       String?
  status      PatientStatus @default(ACTIVE)
  consentGiven Boolean      @default(false)
  consentDate DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  pharmacy      Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("PatientCreatedBy", fields: [createdById], references: [id])
  prescriptions Prescription[]
  consents      PatientConsent[]
  ramReports    RAMReport[]
  loyalty              LoyaltyAccount?
  pointsEntries        PointsEntry[]
  missionCompletions   MissionCompletion[]
  redemptions          Redemption[]
  affiliateClicks      AffiliateClick[]
  affiliateConversions AffiliateConversion[]
  wearableConnections  WearableConnection[]
  wearableSamples      WearableSample[]
  exams                Exam[]
  messages             PatientMessage[]
  appointments         Appointment[]

  @@unique([pharmacyId, phone])
  @@index([pharmacyId, status])
  @@index([phone])
}

enum ConsentScope {
  SERVICE        // base obrigatória — lembretes + RAM
  ANONYMIZED_RESEARCH  // optional — uso anonimizado para pesquisa/laboratório
}

model PatientConsent {
  id           String       @id @default(uuid())
  patientId    String
  scope        ConsentScope
  granted      Boolean
  termsVersion String
  capturedAt   DateTime     @default(now())
  source       String?      // "whatsapp" | "panel" | "qr"

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, scope])
}

// ─────────────────────────────────────────────────────────────────────────────
// Prescription = a medication + posology assigned to a patient
// ─────────────────────────────────────────────────────────────────────────────

enum PrescriptionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String              @id @default(uuid())
  patientId       String
  medicationId    String
  // posology fields (interpreted by lib/prescriptions/posology.ts)
  doseAmount      String              // "1 comprimido", "10 gotas"
  intervalHours   Int?                // when fixed-interval (e.g. 8h, 12h, 24h)
  fixedTimes      String[]            @default([])  // "HH:mm" entries; if set, overrides intervalHours
  durationDays    Int?                // null = continuous treatment
  instructions    String?             // "em jejum", "30min antes da refeição"
  startDate       DateTime
  endDate         DateTime?           // computed if durationDays set
  quantityDispensed Int?              // number of units bought; for "remédio acabando" calc
  prescriber      String?             // doctor name; optional
  status          PrescriptionStatus  @default(ACTIVE)
  pausedReason    String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication         MedicationCatalog   @relation(fields: [medicationId], references: [id])
  createdBy          User                @relation("PrescriptionCreatedBy", fields: [createdById], references: [id])
  reminders          ReminderJob[]
  adherence          AdherenceEvent[]
  ramReports         RAMReport[]
  returnExpectations ReturnExpectation[]

  @@index([patientId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduler: ReminderJob = a single scheduled WhatsApp reminder occurrence
// ─────────────────────────────────────────────────────────────────────────────

enum ReminderStatus {
  PENDING       // scheduled but not yet dispatched
  DISPATCHED    // sent to WhatsApp
  CONFIRMED     // patient said "Tomei"
  DEFERRED      // patient said "Adiar"
  REFUSED       // patient said "Não vou tomar"
  MISSED        // window elapsed without confirmation
  CANCELLED     // prescription paused/cancelled before dispatch
}

model ReminderJob {
  id             String         @id @default(uuid())
  prescriptionId String
  scheduledFor   DateTime
  dispatchedAt   DateTime?
  respondedAt    DateTime?
  status         ReminderStatus @default(PENDING)
  whatsappId     String?        // provider message ID
  refusalReason  String?
  createdAt      DateTime       @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([prescriptionId, scheduledFor])
}

// AdherenceEvent: durable record of patient response (one per ReminderJob terminal state)
enum AdherenceOutcome {
  TAKEN
  REFUSED
  MISSED
  TAKEN_LATE
}

model AdherenceEvent {
  id             String           @id @default(uuid())
  prescriptionId String
  scheduledFor   DateTime
  respondedAt    DateTime?
  outcome        AdherenceOutcome
  reason         String?
  createdAt      DateTime         @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, scheduledFor])
}

// ─────────────────────────────────────────────────────────────────────────────
// RAM (Reação Adversa a Medicamento) — pharmacovigilance reports
// ─────────────────────────────────────────────────────────────────────────────

enum RAMSeverity {
  MILD
  MODERATE
  SEVERE
}

enum RAMStatus {
  PENDING_REVIEW
  REVIEWED
  FORWARDED_VIGIMED
  CLOSED
}

model RAMReport {
  id             String       @id @default(uuid())
  patientId      String
  prescriptionId String?      // suspected medication; nullable for free-text reports
  symptoms       String[]     // selected from list + free text
  freeText       String?
  startedAt      DateTime?
  severity       RAMSeverity
  outcome        String?      // "continued" | "suspended" | "other"
  status         RAMStatus    @default(PENDING_REVIEW)
  reviewedById   String?
  reviewNotes    String?
  vigimedProtocol String?
  forwardedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  reviewedBy   User?         @relation("RAMReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bot conversation state (one per patient phone)
// ─────────────────────────────────────────────────────────────────────────────

model BotConversation {
  id          String   @id @default(uuid())
  pharmacyId  String
  patientId   String?  // null until consent is captured
  phone       String   // E.164, key for inbound routing
  state       String   @default("idle") // idle | awaiting_consent | ram_intake_* | etc
  context     Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([phone])
  @@index([state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Return reminders: when a patient's stock is expected to run out, we ask via
// WhatsApp whether they came back to refill. Highest direct ROI feature for
// the pharmacy (recovers customers who would otherwise drift away).
// ─────────────────────────────────────────────────────────────────────────────

enum ReturnStatus {
  SCHEDULED      // expected but not yet asked
  ASKED          // patient was contacted, awaiting response
  RESTOCKED_HERE // patient said they bought again at this pharmacy
  RESTOCKED_AWAY // patient said they bought at another pharmacy
  STOPPING       // patient said they're stopping the treatment
  EXPIRED        // asked but never responded within window
  CANCELLED      // prescription cancelled before resolution
}

model ReturnExpectation {
  id             String        @id @default(uuid())
  prescriptionId String
  expectedAt     DateTime      // estimated stock end date
  graceDays      Int           @default(2)  // days after expectedAt before asking
  status         ReturnStatus  @default(SCHEDULED)
  askedAt        DateTime?
  respondedAt    DateTime?
  whatsappId     String?       // provider message id
  notes          String?       // free-text response if patient picks "outro"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([status, expectedAt])
  @@index([prescriptionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Loyalty / Gamification (patient-facing engagement hub)
// ─────────────────────────────────────────────────────────────────────────────

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model LoyaltyAccount {
  id          String      @id @default(uuid())
  patientId   String      @unique
  points      Int         @default(0)      // current redeemable balance
  lifetime    Int         @default(0)      // total ever earned (drives tier)
  tier        LoyaltyTier @default(BRONZE)
  streakDays  Int         @default(0)
  lastActueAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Append-only ledger of every point movement (audit + idempotency).
model PointsEntry {
  id         String   @id @default(uuid())
  patientId  String
  delta      Int
  reason     String                 // "mission", "affiliate_conversion", "redemption", "adherence"
  refType    String?
  refId      String?
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reason, refType, refId])   // idempotent awarding
  @@index([patientId, createdAt])
}

enum MissionKind {
  ADHERENCE
  PURCHASE
  PROFILE
  REFERRAL
  CHECKIN
  CUSTOM
}

model Mission {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  description String
  points      Int
  kind        MissionKind @default(CUSTOM)
  icon        String?
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  completions MissionCompletion[]
}

model MissionCompletion {
  id          String   @id @default(uuid())
  patientId   String
  missionId   String
  completedAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([patientId, missionId])
}

enum RewardKind {
  DISCOUNT
  CASHBACK
  PRODUCT
  DONATION
}

model Reward {
  id          String     @id @default(uuid())
  code        String     @unique
  title       String
  description String
  costPoints  Int
  kind        RewardKind @default(DISCOUNT)
  stock       Int?       // null = unlimited
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  redemptions Redemption[]
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model Redemption {
  id         String           @id @default(uuid())
  patientId  String
  rewardId   String
  costPoints Int
  status     RedemptionStatus @default(PENDING)
  voucher    String?          // generated code
  createdAt  DateTime         @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Affiliate program (patient buys via partner pharmacy links; commission + points)
// ─────────────────────────────────────────────────────────────────────────────

model AffiliatePartner {
  id            String   @id @default(uuid())
  slug          String   @unique          // "drogasil"
  name          String
  baseUrl       String                    // https://www.drogasil.com.br
  utmSource     String   @default("meuprontuario")
  utmMedium     String   @default("affiliate")
  commissionPct Float    @default(0)       // % of order value
  pointsPerReal Float    @default(1)       // loyalty points per R$ converted
  logo          String?
  color         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  links       AffiliateLink[]
  conversions AffiliateConversion[]
}

model AffiliateLink {
  id         String   @id @default(uuid())
  code       String   @unique               // short code used in /go/[code]
  partnerId  String
  patientId  String?                         // attributed patient (nullable for generic)
  targetPath String   @default("/")          // path appended to partner baseUrl
  campaign   String?
  createdAt  DateTime @default(now())

  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks  AffiliateClick[]

  @@index([partnerId])
  @@index([patientId])
}

model AffiliateClick {
  id        String   @id @default(uuid())
  linkId    String
  patientId String?
  clickRef  String   @unique                 // our fbclid-style tracking id
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  link        AffiliateLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  patient     Patient?              @relation(fields: [patientId], references: [id])
  conversions AffiliateConversion[]

  @@index([linkId, createdAt])
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  REVERSED
}

model AffiliateConversion {
  id              String           @id @default(uuid())
  partnerId       String
  patientId       String?
  clickId         String?
  externalOrderId String                       // partner's order id (idempotency)
  amountCents     Int              @default(0)
  commissionCents Int              @default(0)
  pointsAwarded   Int              @default(0)
  status          ConversionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  partner AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  patient Patient?         @relation(fields: [patientId], references: [id])
  click   AffiliateClick?  @relation(fields: [clickId], references: [id])

  @@unique([partnerId, externalOrderId])
  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Partner API: per-pharmacy API keys + outbound webhook subscriptions
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(uuid())
  pharmacyId String
  name       String
  prefix     String    @unique               // public id shown in UI (e.g. "pk_live_ab12")
  hash       String                           // sha-256 of the full secret
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
}

model WebhookEndpoint {
  id         String   @id @default(uuid())
  pharmacyId String
  url        String
  secret     String                          // HMAC signing secret
  events     String[] @default([])           // ["ram.created","return.due","order.created"]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([pharmacyId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookDelivery {
  id          String                @id @default(uuid())
  endpointId  String
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  responseCode Int?
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([endpointId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Wearables / Health data (Apple Watch, Samsung, Garmin, Fitbit, Oura, …)
// OAuth providers store tokens; SDK providers (Apple/Samsung) push via ingest.
// ─────────────────────────────────────────────────────────────────────────────

enum WearableProvider {
  APPLE_HEALTH
  SAMSUNG_HEALTH
  GOOGLE_FIT
  GARMIN
  FITBIT
  OURA
  WITHINGS
  POLAR
  MANUAL
}

enum WearableConnStatus {
  PENDING      // awaiting OAuth callback or first ingest
  CONNECTED
  ERROR
  REVOKED
}

model WearableConnection {
  id             String             @id @default(uuid())
  patientId      String
  provider       WearableProvider
  status         WearableConnStatus @default(PENDING)
  externalUserId String?            // provider's user id
  accessToken    String?            // OAuth (encrypt at rest in prod via DB/KMS)
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String[]           @default([])
  ingestTokenHash String?           // sha-256 of the push token (Apple/Samsung/SDK)
  lastSyncAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, provider])
  @@index([patientId])
}

enum HealthMetric {
  HEART_RATE
  RESTING_HR
  STEPS
  SLEEP_MINUTES
  SPO2
  HRV
  CALORIES
  WEIGHT
  GLUCOSE
  BLOOD_PRESSURE_SYS
  BLOOD_PRESSURE_DIA
  TEMPERATURE
}

model WearableSample {
  id         String           @id @default(uuid())
  patientId  String
  provider   WearableProvider
  metric     HealthMetric
  value      Float
  unit       String
  recordedAt DateTime
  source     String?          // device label e.g. "Apple Watch Series 9"
  externalId String?          // provider sample id (idempotency)
  createdAt  DateTime         @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, metric, recordedAt, provider])
  @@index([patientId, metric, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Patient self-login via WhatsApp OTP (one-time code → signed hub token)
// ─────────────────────────────────────────────────────────────────────────────

model PatientLoginCode {
  id         String    @id @default(uuid())
  phone      String    // E.164
  codeHash   String    // sha-256 of the 6-digit code
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Exams — patient documents (lab results, imaging) stored in Supabase Storage
// ─────────────────────────────────────────────────────────────────────────────

enum ExamStatus {
  PENDING   // upload started, file not confirmed yet
  READY
  ARCHIVED
}

model Exam {
  id         String     @id @default(uuid())
  patientId  String
  pharmacyId String     // denormalized for tenant scoping/indexing
  title      String
  category   String?    // "Laboratorial" | "Imagem" | "Receita" | ...
  fileKey    String     // storage object path within the bucket
  fileName   String
  mimeType   String
  sizeBytes  Int        @default(0)
  status     ExamStatus @default(READY)
  uploadedBy String?    // userId (staff) or "patient"
  notes      String?
  createdAt  DateTime   @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([pharmacyId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Patient ↔ pharmacy messaging (in-app thread; complements WhatsApp)
// ─────────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  FROM_PATIENT
  FROM_PHARMACY
}

model PatientMessage {
  id         String           @id @default(uuid())
  patientId  String
  pharmacyId String
  direction  MessageDirection
  body       String
  authorName String?          // staff display name when FROM_PHARMACY
  readAt     DateTime?        // read by the *other* side
  createdAt  DateTime         @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([pharmacyId, readAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointments / consultas (pharmaceutical care, vaccines, follow-ups)
// ─────────────────────────────────────────────────────────────────────────────

enum AppointmentKind {
  CONSULTATION
  FOLLOWUP
  EXAM
  VACCINE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  pharmacyId   String
  title        String
  kind         AppointmentKind   @default(CONSULTATION)
  scheduledAt  DateTime
  durationMin  Int               @default(30)
  location     String?
  professional String?
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, scheduledAt])
  @@index([pharmacyId, scheduledAt])
}
